{
  "name": "plextype",
  "version": "0.9.2",
  "private": true,
  "scripts": {
    "setup": "node setup.mjs",
    "dev": "dotenv -e .env -e .env.development next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "release": "release-it",
    "deploy": "npm version patch && git push origin main --follow-tags",
    "prisma:sync": "node scripts/sync-prisma.mjs",
    "prisma:generate": "npm run prisma:sync && npx prisma generate",
    "migrate:dev": "npm run prisma:sync && dotenv -e .env -e .env.development -- npx prisma migrate dev",
    "migrate:reset": "npm run prisma:sync && dotenv -e .env -e .env.development -- npx prisma migrate reset",
    "migrate:init": "npm run prisma:sync && dotenv -e .env -e .env.development -- npx prisma migrate dev --name init",
    "dbpush:push": "npm run prisma:sync && dotenv -e .env -e .env.development -- npx prisma db push",
    "db:seed": "dotenv -e .env -e .env.development -- npx prisma db seed"
  },
  "prisma": {
    "seed": "dotenv -e .env -e .env.development -- node src/core/prisma/seed.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/config": "^7.8.0",
    "@tailwindcss/cli": "^4.0.13",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-query": "^5.68.0",
    "@tiptap/extension-bullet-list": "^3.16.0",
    "@tiptap/extension-highlight": "^3.16.0",
    "@tiptap/extension-image": "^3.16.0",
    "@tiptap/extension-list-item": "^3.16.0",
    "@tiptap/extension-link": "^3.16.0",
    "@tiptap/extension-ordered-list": "^3.16.0",
    "@tiptap/extension-placeholder": "^3.16.0",
    "@tiptap/extension-table": "^3.16.0",
    "@tiptap/extension-table-cell": "^3.16.0",
    "@tiptap/extension-table-header": "^3.16.0",
    "@tiptap/extension-table-row": "^3.16.0",
    "@tiptap/extension-text-align": "^3.16.0",
    "@tiptap/extension-underline": "^3.16.0",
    "@tiptap/html": "^3.16.0",
    "@tiptap/react": "^3.16.0",
    "@tiptap/starter-kit": "^3.16.0",
    "@types/crypto-js": "^4.2.2",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "dayjs": "^1.11.13",
    "dotenv-cli": "^8.0.0",
    "firebase-admin": "^14.0.0",
    "framer-motion": "^12.5.0",
    "ioredis": "^5.10.1",
    "isomorphic-dompurify": "^2.35.0",
    "jose": "^6.0.9",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.562.0",
    "mime-types": "^3.0.1",
    "nanoid": "^5.1.9",
    "next": "^16.2.6",
    "pg": "^8.20.0",
    "prismjs": "^1.29.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.72.0",
    "relative-time": "^1.0.0",
    "sharp": "^0.34.5",
    "shiki": "^3.23.0",
    "systeminformation": "^5.31.6",
    "tiptap-extension-code-block-shiki": "^1.1.0",
    "uuid": "^13.0.1",
    "v8": "^0.1.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.3.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.10",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.12",
    "postcss": "^8.5.14",
    "prettier": "^3.5.3",
    "prisma": "^7.8.0",
    "release-it": "^20.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "@hono/node-server": "2.0.2",
    "fast-uri": "3.1.2",
    "hono": "4.12.18",
    "postcss": "$postcss"
  }
}
